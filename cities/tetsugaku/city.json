  "tour": [
    {
      "title": "The Philosopher's Path",
      "text": "Two kilometres along a little canal at the foot of the eastern hills, from Ginkaku-ji to Nanzen-ji. In early April the cherries meet overhead; in November the maples burn red.",
      "cam": [
        -480,
        120,
        360
      ],
      "tgt": [
        250,
        150,
        90
      ],
      "date": [
        4,
        2
      ],
      "from": "10:00",
      "to": "11:00",
      "hold": 8
    },
    {
      "title": "Ginkaku-ji",
      "text": "The Silver Pavilion, Ashikaga Yoshimasa's retreat of 1489, was never silvered. Its raked sand garden and moss are the purest Zen in Kyoto; the path begins at the bridge below.",
      "cam": [
        120,
        900,
        160
      ],
      "tgt": [
        520,
        1045,
        90
      ],
      "date": [
        4,
        2
      ],
      "from": "09:30",
      "to": "10:30",
      "hold": 7
    },
    {
      "title": "Along the canal",
      "text": "The philosopher Nishida Kitaro walked here every day to think. Painter Hashimoto Kansetsu and his wife planted the cherries from 1922, and their petals still drift on the water each spring.",
      "cam": [
        160,
        260,
        130
      ],
      "tgt": [
        300,
        520,
        75
      ],
      "date": [
        4,
        2
      ],
      "from": "14:00",
      "to": "15:00",
      "hold": 7
    },
    {
      "title": "Nanzen-ji and the aqueduct",
      "text": "Climb the great Sanmon for the view a famous outlaw admired in kabuki: \"Spectacular, spectacular!\" Behind it, a red-brick Roman-style aqueduct carries the canal through the temple grounds.",
      "cam": [
        -150,
        -650,
        140
      ],
      "tgt": [
        110,
        -790,
        70
      ],
      "date": [
        11,
        25
      ],
      "from": "15:00",
      "to": "16:00",
      "hold": 8
    },
    {
      "title": "The Keage Incline",
      "text": "Boats once rode cradles up and down these rails between the canal's two levels. Now it's a walk under the cherries, and on a spring weekend the most photographed tracks in Japan.",
      "cam": [
        -420,
        -1150,
        150
